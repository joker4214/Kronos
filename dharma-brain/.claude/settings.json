{
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(npm *)",
      "Bash(vercel *)",
      "Bash(curl *)",
      "Read(**)",
      "Glob(**)",
      "Grep(**)",
      "Write",
      "Edit"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo \"[perm-check] mode=$CLAUDE_PERMISSION_MODE cwd=$(pwd)\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/grego/.local/bin/graphify.EXE hook-guard search"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/grego/.local/bin/graphify.EXE hook-guard read"
          }
        ]
      }
    ]
  }
}