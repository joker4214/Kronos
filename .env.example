# Server-side Supabase client (app/lib/supabase.js)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Used directly by app/api/projects/route.js and app/api/clients/route.js
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Anthropic SDK (app/lib/claude.js, app/lib/widgetAgent.js)
CLAUDE_API_KEY=

# Resend — lead notification emails (app/lib/leadNotify.js)
# Get a free key at https://resend.com after verifying the dharmasemporium.com sending domain
RESEND_API_KEY=

# Optional — overrides the auto-detected origin used to build embed snippets.
# Only needed if Kronos is proxied/behind a domain the request doesn't reveal.
KRONOS_BASE_URL=
