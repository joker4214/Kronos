# Database
DATABASE_URL="postgresql://user:password@localhost:5432/kronos"

# Google Calendar API
GOOGLE_CALENDAR_ID="your-calendar-id@gmail.com"
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Anthropic Claude API
ANTHROPIC_API_KEY="sk-ant-your-key"

# Platform Integration (for posting and metrics)
INSTAGRAM_BUSINESS_ACCOUNT_ID="your-account-id"
INSTAGRAM_ACCESS_TOKEN="your-access-token"

TIKTOK_BUSINESS_ACCOUNT_ID="your-account-id"
TIKTOK_ACCESS_TOKEN="your-access-token"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Gumroad Ping webhook auth (Settings > Advanced > Ping, appended as ?secret=)
GUMROAD_PING_SECRET="your-random-token"

# Contact form -> Microsoft Graph (app-only, client credentials -- no redirect
# URI, this is a separate Azure app registration from any user-sign-in app)
GRAPH_TENANT_ID="your-tenant-id"
GRAPH_CLIENT_ID="your-client-id"
GRAPH_CLIENT_SECRET="your-client-secret-value"
CONTACT_MAILBOX="jason@dharmasestheticdesign.com"
